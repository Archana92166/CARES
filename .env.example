# Copy to a deployment-specific environment file; never commit real secrets.

# Local presentation/demo configuration.
CARES_ENABLE_DEMO=1
CARES_DEMO_CONTINUOUS=1
CARES_DEMO_INTERVAL_SECONDS=0.02
CARES_ENABLE_LIVE_ACTIONS=0
CARES_COOKIE_SECURE=0

# Hardware deployment configuration. The token is supplied by the operator.
CARES_HARDWARE_DEVICE_ID=esp32-max30100
CARES_HARDWARE_USER_ID=1
CARES_DEVICE_TOKEN=replace-with-device-secret
# Alternatively use a JSON mapping for multiple devices:
# CARES_HARDWARE_DEVICES={"esp32-max30100":{"user_id":1,"token":"replace-with-device-secret"}}

# Use an absolute path for persistent deployment storage.
# CARES_DB_PATH=/var/lib/cares/cares.sqlite3

# Production defaults should keep demo and live external actions disabled
# unless explicitly reviewed and configured.
# CARES_ENABLE_DEMO=0
# CARES_ENABLE_LIVE_ACTIONS=0
